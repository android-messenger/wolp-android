<?xml version="1.0" encoding="utf-8"?>
<!-- S1 §4.3: no cleartext, system CAs only (user CAs not trusted). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
