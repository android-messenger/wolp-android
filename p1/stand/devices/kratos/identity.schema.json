{
  "$id": "https://wolp.stand/identity.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Person",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "E-Mail",
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            }
          }
        },
        "name": {
          "type": "object",
          "properties": {
            "first": {
              "type": "string",
              "title": "First name"
            },
            "last": {
              "type": "string",
              "title": "Last name"
            }
          }
        },
        "role": {
          "type": "string",
          "title": "Role"
        },
        "locale": {
          "type": "string",
          "title": "Locale"
        },
        "avatar_url": {
          "type": "string",
          "title": "Avatar URL"
        }
      },
      "required": [
        "email"
      ],
      "additionalProperties": false
    }
  }
}
